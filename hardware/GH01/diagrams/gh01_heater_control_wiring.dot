digraph GH01_Wiring {
  rankdir=LR;
  graph [fontsize=10, fontname="Helvetica", labelloc=t, label="GH01 Heater Control Wiring (Pin-Level)"];
  node [shape=record, fontsize=10, fontname="Helvetica"];
  edge [fontsize=9, fontname="Helvetica"];

  subgraph cluster_lv {
    label="Low Voltage Domain";
    color=lightgrey;

    xiao [label="{XIAO ESP32C3|{<d6>D6/GPIO21|<gnd>GND|<v3>3V3|<v5>5V/VUSB}}"];
    mosfet [label="{AO3400A (SOT-23)|{<g>G|<d>D|<s>S}}"];
    rgate [shape=box, label="R_GATE\n100R..220R"];
    rpulldown [shape=box, label="R_PULLDOWN\n100k"];
    psu5 [shape=box, label="AC-DC Module\n+5V / 0V"];
    ssr_in [label="{CX240D5 Input|{<inp>IN+|<inn>IN-}}"];
  }

  subgraph cluster_ac {
    label="AC / Mains Domain";
    color=lightgrey;

    mains [shape=box, label="240V AC In\nL / N / PE"];
    fuse [shape=box, label="Fuse / Protection\n(Live path)"];
    ssr_out [label="{CX240D5 Output|{<out1>OUT1|<out2>OUT2}}"];
    cable [shape=box, label="Soil Warming Cable\n27W / 3m"];
    earth [shape=box, label="PE to Enclosure\n(as required)"];
  }

  # GPIO to MOSFET gate drive
  xiao:d6 -> rgate [label="control signal"];
  rgate -> mosfet:g;
  mosfet:g -> rpulldown;
  rpulldown -> xiao:gnd [label="to GND"];

  # MOSFET low-side switching path for SSR input
  psu5 -> ssr_in:inp [label="+5V to IN+"];
  ssr_in:inn -> mosfet:d [label="IN- to Drain"];
  mosfet:s -> xiao:gnd [label="Source to GND"];
  psu5 -> xiao:gnd [label="0V common GND"];

  # AC path through SSR to cable
  mains -> fuse [label="Live (L)"];
  fuse -> ssr_out:out1 [label="to OUT1"];
  ssr_out:out2 -> cable [label="switched Live to cable"];
  mains -> cable [label="Neutral (N)"];
  mains -> earth [label="PE"];

  # Visual relation between input and output sides of same SSR device
  ssr_in -> ssr_out [style=dashed, arrowhead=none, label="internal isolation\n(control vs load)"];
}
